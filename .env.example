NODE_ENV=development
PORT=3010
API_BASE_URL=http://localhost:3010
CORS_ORIGINS=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Leave empty for direct connections. Set only actual reverse proxy IPs/CIDRs.
TRUSTED_PROXIES=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=task_kpi
DB_PASSWORD=
DB_DATABASE=task_kpi
# Enable only for a disposable local development database.
DB_SYNCHRONIZE=false
OTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Independent from JWT_SECRET; same secret on the Next BFF.
BFF_PROXY_SECRET=
# Shared across all backend workers. Use Redis ACL/TLS and a private network.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_PREFIX=careops:production:
